--- a/src/video/windows/SDL_windowskeyboard.c
+++ b/src/video/windows/SDL_windowskeyboard.c
@@ -1011,8 +1011,6 @@
                         UINT page_start = 0;
                         UINT page_size = 0;
 
-                        videodata->ime_candsel = cand_list->dwSelection;
-
                         if (LANG() == LANG_CHS && IME_GetId(videodata, 0)) {
                             const UINT maxcandchar = 18;
                             size_t cchars = 0;
@@ -1032,14 +1030,34 @@
                             }
                             page_size = i - page_start;
                         } else {
-                            page_size = SDL_min(cand_list->dwPageSize == 0 ? MAX_CANDLIST : cand_list->dwPageSize, MAX_CANDLIST);
+                            const DWORD ime_page_size = (cand_list->dwPageSize == 0) ? MAX_CANDLIST : cand_list->dwPageSize;
+
+                            page_size = SDL_min(ime_page_size, MAX_CANDLIST);
                             page_start = (cand_list->dwSelection / page_size) * page_size;
+
+                            // Prefer the page the IME reports, as long as the selection is on it. Pages
+                            // computed from the selection overlap when the IME changes the page size.
+                            // An IME page that is too large to send is split into smaller pages.
+                            if (cand_list->dwPageStart <= cand_list->dwSelection && cand_list->dwSelection - cand_list->dwPageStart < ime_page_size) {
+                                const DWORD offset = ((cand_list->dwSelection - cand_list->dwPageStart) / page_size) * page_size;
+
+                                page_start = cand_list->dwPageStart + offset;
+                                page_size = SDL_min(page_size, ime_page_size - offset);
+                            }
                         }
                         for (i = page_start, j = 0; (DWORD)i < cand_list->dwCount && j < page_size; i++, j++) {
                             LPCWSTR candidate = (LPCWSTR)((DWORD_PTR)cand_list + cand_list->dwOffset[i]);
                             IME_AddCandidate(videodata, j, candidate);
                         }
 
+                        // Only the current page is sent, indexed from zero, so the selection has to be
+                        // relative to the start of that page, rather than to the whole list.
+                        if (cand_list->dwSelection >= page_start && cand_list->dwSelection - page_start < j) {
+                            videodata->ime_candsel = cand_list->dwSelection - page_start;
+                        } else {
+                            videodata->ime_candsel = (DWORD)-1;
+                        }
+
                         has_candidates = true;
                         IME_SendCandidateList(videodata);
                     }
